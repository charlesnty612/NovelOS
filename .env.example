# ── NovelOS 环境变量模板（BUG-39）────────────────────────────────────────────
# 用法：复制成 .env（.gitignore 已放行本文件、忽略 .env*），再按需填值。
# ★ 本文件**只写键名 ＋ 空占位 ＋ 注释**：零真实凭据、零真实路径、零真实 token。
# ★ 值一律留空＝「不设置」⇒ 各键按代码里的默认口径走（默认口径以代码现读为准）。
#
# 键集口径（2026-10-25 现读仓内 .py 真实读取的 NOVELOS_* 键 ＝ 45）：
#   · 模板生效 39 ＝ 核心 7 ＋ 生产可配 26 ＋ 凭据 6（只给空占位）
#   · 白名单排除 6 ＝ 测试专用 5 ＋ 前缀产物 1（NOVELOS_API_KEY_ 是动态前缀，不是键）
#
# ── 核心（7）─────────────────────────────────────────────────────────────────
# 数据根：留空 ⇒ 落仓外绝对默认（~/.novelos/data），**不会**指向仓内 ./data
NOVELOS_DATA_DIR=
# SQLite 库路径：留空 ⇒ <data_dir>/novelos.db
NOVELOS_DB_PATH=
# 凭据文件路径：留空 ⇒ <仓库根>/secrets.json
NOVELOS_SECRETS_FILE=
# 日志级别：留空 ⇒ INFO
NOVELOS_LOG_LEVEL=
# 服务端口：留空 ⇒ 18081（NOVELOS_API_PORT 是旧的精细变量，兼容保留）
NOVELOS_PORT=
NOVELOS_API_PORT=
# 监听地址：留空 ⇒ 127.0.0.1
NOVELOS_API_HOST=
#
# ── 凭据（6）★ 只给空占位，值请写进 .env 或系统环境变量 ──────────────────────
# 各 provider 的 API Key（provider 名大写；其余 provider 同族见下方说明）
NOVELOS_API_KEY_ANTHROPIC=
NOVELOS_API_KEY_DEEPSEEK=
NOVELOS_API_KEY_KIMI=
NOVELOS_API_KEY_OPENAI=
NOVELOS_API_KEY_OPENAI_COMPATIBLE=
# 备份文件加密口令（scripts/backup_db.py 用）
NOVELOS_BACKUP_KEY=
# ★ provider 键族：未列出的 provider，其键名是 NOVELOS_API_KEY_<PROVIDER 大写>
#   （由 packages/core/model_router/providers.py 按 provider 名动态解析）。
#
# ── 生产可配（26）───────────────────────────────────────────────────────────
# 痕迹仓根目录（评估/报告产物的落点）
NOVELOS_ARTIFACTS_DIR=
# 自动返修次数上限（留空 ⇒ 2）
NOVELOS_AUTO_REVISE_MAX=
# 备份输出目录（命令行 --out 优先于它）
NOVELOS_BACKUP_DIR=
# NovelOS 服务地址（skills/novelos 脚本用）
NOVELOS_BASE_URL=
# 内容仓目录（可读性审计等脚本用）
NOVELOS_CONTENT_DIR=
# 上下文相关性检索：off 关闭（大小写不敏感）
NOVELOS_CONTEXT_RELEVANCE=
# critic 模式（chapter-review 节点用）
NOVELOS_CRITIC_MODE=
# 调试产物目录：**默认落点以 packages/core/agent_runtime/runner.py 现读为准**
#   （B1 已合入 ⇒ 默认落仓外 ~/.novelos/debug）；不要写死成仓内相对目录
NOVELOS_DEBUG_DIR=
# 调试：落 observer 输入 payload（置 1 开启）
NOVELOS_DEBUG_OBSERVER_PAYLOAD=
# 生产排障：provider 响应 dump 目录
NOVELOS_DEBUG_PROVIDER_DUMP_DIR=
# 逗号分隔的禁用模块名（留空 ⇒ 不禁用任何模块）
NOVELOS_DISABLED_MODULES=
# 快速模式开关
NOVELOS_FAST_MODE=
# 实例 id（常驻服务建议固定它，否则每次启动重生成）
NOVELOS_INSTANCE_ID=
# observer 并行提交（留空 ⇒ on；off 回退串行）
NOVELOS_OBSERVER_PARALLEL=
# observer 分成两条轻量 leg（留空 ⇒ on；off 走旧单次调用路径）
NOVELOS_OBSERVER_SPLIT=
# 性能测量子进程的内部标记（脚本内部用，一般不需要设）
NOVELOS_PERF_CHILD=
# 提示词自愈同步开关（留空 ⇒ on；off 关闭）
NOVELOS_PROMPT_SYNC=
# 质量门禁模式（enforce / report）
NOVELOS_QUALITY_GATE=
# Q8 严格档（置 1 ⇒ 升级为会阻断的 error 档）
NOVELOS_QUALITY_Q8_STRICT=
# 仓库根（skills/novelos 脚本用）
NOVELOS_REPO_ROOT=
# 人工基线严格闸（1/true/yes/on ⇒ 语料不可得时判红）
NOVELOS_REQUIRE_HUMAN_BASELINE=
# summary 节点并行（留空 ⇒ on；off 不提前调用）
NOVELOS_SUMMARY_PARALLEL=
# 前端产物目录（覆盖 apps/web/dist）
NOVELOS_WEB_DIST=
# 写作上下文模式（全局开关）
NOVELOS_WRITER_CONTEXT_MODE=
# 章节长度不达标时的额外重试次数（留空 ⇒ 2；0 ＝ 关闭）
NOVELOS_WRITER_LENGTH_RETRIES=
# ★ 危险开关：允许仓内库路径（默认**只收紧不放宽**；确需时再置 1）
NOVELOS_ALLOW_REPO_LOCAL_DB=
#
# ── 危险开关（只在注释里，默认不设）──────────────────────────────────────────
# NOVELOS_ALLOW_PUSH —— 放行 push（读取方是 .githooks/pre-push，不在 .py 扫描面内）
#   ★ 默认不设；本仓默认禁止 push，确需放行才设它。
